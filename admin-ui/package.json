{
  "name": "raisfast-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reimplementation of the RaisFast Admin UI (reverse-engineered). CMS / platform routes only — no e-commerce or payments.",
  "scripts": {
    "dev:mock": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "dev": "VITE_MOCK=false vite"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@uiw/react-md-editor": "^4.0.4",
    "@xyflow/react": "^12.3.6",
    "chart.js": "^4.4.7",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "msw": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
